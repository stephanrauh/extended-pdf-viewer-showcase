<< /Type /Action /S /JavaScript /JS (if \(globalThis.ngxLog\) { ngxLog\("OpenAction \(/OpenAction\)"\); } else { console.println\("OpenAction \(/OpenAction\)"\); } app.alert\("OpenAction: this script ran while the document was being opened."\);) >>
